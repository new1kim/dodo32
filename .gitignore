# ============================================================
# dodo32 — .gitignore
#
# 이 저장소는 "공개 GitHub 저장소"이자 "앱의 실시간 배포 소스"다.
# 앱이 실행 시 https://raw.githubusercontent.com/new1kim/dodo32/main/<파일>
# 로 파일을 내려받으므로, 여기서 제외하면 그대로 앱이 깨진다.
#
# 그래서 "전부 무시하고 앱이 쓰는 것만 허용" 하는 허용목록(allow-list) 방식으로 둔다.
# 파일을 새로 추가해 배포해야 하면 맨 아래 "앱 배포 파일" 목록에 추가한다.
# ============================================================

# ---------- 기본: 전부 무시 ----------
*

# ---------- 앱 배포 파일 (이것만 추적) ----------

# 진입점 / 공통
!.gitignore
!index.html
!gate-auth.js
!ads.txt

# 빌드 도우미 / 규칙 문서
!CLAUDE.md
!build_android.ps1

# 상담 화면 세트
!Consult_Main.html
!Consult_calculator_logic.js
!Consult_calculator_ui.js
!Consult_style.css

# DSR 화면 세트
!DSR_Main.html
!DSR_calculator_logic.js
!DSR_calculator_ui.js
!DSR_style.css

# 개별 화면
!상담일지.html
!DTI.html
!계산기.html
!날짜계산기.html
!MCG.html
!IDCard.html
!문서스캔.html
!시세조회.html
!gonsi.html

# 화면에서 쓰는 이미지
!소액임차보증금.png
!장래예상소득증가율.png
!신용점수기준.png
!24년담보인정비율.png

# 오피스텔 공시 정적자료 (gonsi.html이 의존)
!op_gongsi_data/
!op_gongsi_data/**

# 오피스텔 공시 정적자료 (gonsi.html이 의존)
!op_gongsi_data/
!op_gongsi_data/**

# 문서 / 프로젝트 정의
!CLAUDE.md
!README.md
!package.json
!package-lock.json

# ---------- 하위 폴더 규칙 ----------
# 위 허용목록은 "*" 로 전부 막은 뒤의 예외이므로, 폴더를 통과시키려면
# 그 폴더 자체와 내용을 함께 허용해야 한다.
!CallNote/
!CallNote/**


# ============================================================
# 여기서부터는 "명시적 제외" — 허용목록에 걸려도 절대 올리지 않는다.
# (허용보다 뒤에 있으면 우선한다)
# ============================================================

# ---------- 백업 (절대 커밋 금지) ----------
Backup/
backup/
Backup/file_backups/
*.bak
*.bak-*
*.diag-bak
*.orig
*.old
*.save

# ---------- 작업 중 임시 파일 ----------
_qa_*.mjs
_qa_*
_check*.js
*.tmp
*.temp
*.log
.DS_Store
Thumbs.db

# ---------- 빌드 산출물 ----------
CallNote/app/build/
CallNote/build/
CallNote/.gradle/
CallNote/local.properties
*.apk
*.aab
*.ap_
*.dex
*.jar
!CallNote/gradle/wrapper/gradle-wrapper.jar

# ---------- 개발 도구 ----------
.vscode/
.idea/
.clasp-deploy/
.clasp.json
node_modules/
__pycache__/
*.pyc
.venv/
venv/

# CallNote(Android) — 소스와 빌드 설정은 함께 추적한다.
# 단, 아래 "절대 제외"보다 위에 있으면 안 되므로 실제 허용은 파일 끝에서 다시 선언한다.

# ---------- 아티팩트 / 분석 산출물 ----------
graphify-out/
.tmp.driveupload/
*.min.js.map
.merge-*


# ============================================================
# ★★ 최종 제외 영역 ★★
# gitignore 는 "나중 규칙이 이긴다". 위 허용목록(!...)에 걸리더라도
# 여기 있는 규칙이 항상 우선하도록 파일 맨 끝에 둔다.
# ============================================================

# ---------- 백업: 절대 커밋 금지 ----------
Backup/
backup/
*.bak
*.bak-*
*.diag-bak
*.orig
*.old
*.save

# ---------- 작업 중 임시 파일 ----------
_qa_*.mjs
_qa_*
_check*.js
*.tmp
*.temp
*.log
.DS_Store
Thumbs.db

# ---------- 빌드 산출물 ----------
CallNote/app/build/
CallNote/build/
CallNote/.gradle/
CallNote/local.properties
*.apk
*.aab
*.ap_
*.dex

# ---------- 시크릿 ----------
# (이미 추적 중인 파일에는 효력이 없다. 새 파일만 막힌다)
.env
.env.*
*/secrets.*
*/credentials.*

# ---------- CallNote 추적 허용 (제외 규칙보다 뒤에 있어야 살아남는다) ----------
!CallNote/
!CallNote/app/
!CallNote/app/src/
!CallNote/app/src/main/
!CallNote/app/src/main/java/
!CallNote/app/src/main/java/**
!CallNote/app/src/main/assets/
!CallNote/app/src/main/assets/**
!CallNote/app/src/main/res/
!CallNote/app/src/main/res/**
!CallNote/app/src/main/AndroidManifest.xml
!CallNote/app/build.gradle
!CallNote/app/build.gradle.kts
!CallNote/app/proguard-rules.pro
!CallNote/build.gradle
!CallNote/build.gradle.kts
!CallNote/settings.gradle
!CallNote/settings.gradle.kts
!CallNote/gradle.properties
!CallNote/gradle/
!CallNote/gradle/**
!CallNote/gradle/wrapper/gradle-wrapper.jar
!CallNote/gradlew
!CallNote/gradlew.bat

# 그 중에서도 절대 올리면 안 되는 것 (허용보다 뒤 = 최종 승리)
CallNote/**/*.bak
CallNote/**/*.bak-*
CallNote/**/*.bak-*.kt
CallNote/**/*.diag-bak
CallNote/**/*.orig
CallNote/app/build/
CallNote/.gradle/
CallNote/local.properties
CallNote/.idea/
# ============================================================
# GAS 소스(.gs) - 절대 커밋 금지 (맨 끝 = 항상 우선)
#
# .gs는 구글 서버에서만 실행되는 코드이고 API 키가 들어 있다.
# 이 저장소는 "공개"이면서 동시에 "앱 배포 소스"라서, .gs를 올리면 키가 그대로 노출된다.
# 앱은 .gs를 쓰지 않으므로(AssetSyncManager.FILES에 없음) 제외해도 앱은 정상 동작한다.
#
# 작업 방식:
#   로컬에서 .gs 편집 -> 구글 Apps Script 에디터에 붙여넣기 -> 저장/배포
# ============================================================
*.gs