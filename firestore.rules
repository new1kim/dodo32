rules_version = '2';

// dodo32 상담저장소 - Firestore 보안 규칙
// 원칙: 로그인한 사용자는 "자기 데이터"만 읽고 쓸 수 있다.
//   - 상담 내용(민감정보)이므로 남의 데이터 접근을 원천 차단한다.
//   - 클라이언트는 users/{uid} 하위 경로만 사용한다.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    // 경로의 {uid} 가 로그인한 사용자 토큰의 uid 와 같아야 한다.
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // 사용자 프로필 (닉네임, 이메일, 가입일, 결제 플랜 플래그 등)
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid);
      allow delete: if false; // 계정 삭제는 관리자/함수에서만

      // 사용자별 상담 내용
      match /consults/{consulId} {
        allow read, write: if isOwner(uid);
      }

      // 사용자별 사용 내역(접속/버튼 사용 기록)
      match /usage/{eventId} {
        allow read, write: if isOwner(uid);
      }

      // 결제/구독 상태: 읽기만 클라이언트 허용, 쓰기는 서버(Cloud Functions)만.
      // (클라이언트가 스스로 결제 상태를 조작하지 못하게 한다 - 보안 핵심)
      match /subscription/{docId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
    }
  }
}
